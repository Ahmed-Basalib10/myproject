# Copy this file to .env for local runs of scripts/update-prices.js
# (.env itself is gitignored — never commit real keys).
# In GitHub Actions, these are set as repository secrets instead, not a
# committed .env file.

# Metal Sentinel key, via RapidAPI — https://rapidapi.com/
# (previously GOLDAPI_KEY; switched providers, see scripts/update-prices.js)
RAPIDAPI_KEY=your_rapidapi_key_here

# USD -> SAR conversion rate. SAR is effectively pegged (~3.75), so a fixed
# constant is fine; leave unset to fall back to the default in the script.
USD_SAR_RATE=3.75

# Minimum minutes between Metal Sentinel calls. Confirm the actual free-tier
# quota on your RapidAPI dashboard before relying on any specific number —
# adjust this to whatever keeps 2 calls/run (gold+silver) comfortably under
# it. Mirrors the cron schedule in .github/workflows/update-prices.yml —
# update both together, this value alone doesn't change the schedule.
UPDATE_INTERVAL_MINUTES=15

# Production domain (no trailing slash), used for <link rel="canonical">,
# the JSON-LD "url" fields, and sitemap.xml. Also hardcoded directly in the
# GitHub Actions workflow (not a secret, no need to template it there).
SITE_URL=https://dhahabksa.com
